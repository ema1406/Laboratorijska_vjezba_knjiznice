{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/ema1406/Laboratorijska_vjezba_knjiznice/main/schema.json",
    "title": "Knjiznice Schema",
    "description": "Ovaj skup podataka sadrži informacije o odabranim javnim knjižnicama na području Republike Hrvatske. Podaci obuhvaćaju osnovne informacije o knjižnicama, njihovim odjelima i zaposlenicima.",
    "type": "array",
    "items": {
        "type": "object",
        "title": "Knjižnice",
        "description": "Ovaj skup podataka sadrži informacije o odabranim javnim knjižnicama na području Republike Hrvatske. Podaci obuhvaćaju osnovne informacije o knjižnicama, njihovim odjelima i zaposlenicima.",
        "properties": {
            "naziv": {
                "type": "string",
                "title": "Naziv knjižnice",
                "description": "puni naziv knjižnice"
            },
            "adresa": {
                "type": "string",
                "title": "Adresa",
                "description": "ulica i kućni broj knjižnice"
            },
            "postanski_broj": {
                "type": "string",
                "title": "Poštanski broj",
                "description": "poštanski broj knjižnice"
            },
            "grad": {
                "type": "string",
                "title": "Grad",
                "description": "grad u kojem se knjižnica nalazi"
            },
            "zupanija": {
                "type": "string",
                "title": "Županija",
                "description": "županija u kojoj se knjižnica nalazi"
            },
            "telefon": {
                "type": [
                    "string",
                    "number"
                ],
                "title": "Telefon",
                "description": "kontakt broj knjižnice"
            },
            "mail": {
                "type": "string",
                "format": "email",
                "title": "Email",
                "description": "kontakt email knjižnice"
            },
            "web": {
                "type": "string",
                "format": "uri",
                "title": "Web stranica",
                "description": "službena web stranica navedene knjižnice"
            },
            "vrsta_knjiznice": {
                "type": "string",
                "title": "Vrsta knjižnice",
                "description": "vrsta knjižnice"
            },
            "odjeli": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "odjel_naziv": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "title": "Naziv odjela",
                            "description": "naziv odjela specifičan za tu knjižnicu"
                        }
                    },
                    "required": [
                        "odjel_naziv"
                    ]
                }
            },
            "zaposlenici": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "ime": {
                            "type": "string",
                            "title": "Ime",
                            "description": "ime zaposlenika navedeno na web stranici knjižnice"
                        },
                        "prezime": {
                            "type": "string",
                            "title": "Prezime",
                            "description": "prezime zaposlenika navedeno na web stranici knjižnice"
                        },
                        "radni_odnos": {
                            "type": "string",
                            "title": "Radni odnos",
                            "description": "na kojoj poziciji je zaposlenik"
                        }
                    },
                    "required": [
                        "ime",
                        "prezime",
                        "radni_odnos"
                    ]
                }
            }
        },
        "required": [
            "naziv",
            "adresa",
            "postanski_broj",
            "grad",
            "zupanija",
            "telefon",
            "mail",
            "web",
            "vrsta_knjiznice",
            "odjeli",
            "zaposlenici"
        ]
    }
}